    <title>v8.3.6</title>
    <content type="html">&lt;h3&gt;Bug Fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;await overlapping plugin container close calls (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23935&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23935/hovercard&quot;&gt;#23935&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/175bbeb231fe8bbf260b0b3866b30080690c4f5e&quot;&gt;175bbeb&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;build:&lt;/strong&gt; resolve dynamic imports with queries appended when collecting CSS dependencies (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23909&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23909/hovercard&quot;&gt;#23909&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/df365589738866363fff7335ed58948a5c440580&quot;&gt;df36558&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;build:&lt;/strong&gt; use stable module ids in chunk import map hash signatures (fix &lt;a href=&quot;https://github.com/vitejs/vite/issues/23975&quot; data-hovercard-type=&quot;issue&quot; data-hovercard-url=&quot;/vitejs/vite/issues/23975/hovercard&quot;&gt;#23975&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23976&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23976/hovercard&quot;&gt;#23976&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/8069835ac32ae7682b34de55fdba6c5d2484bae0&quot;&gt;8069835&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;bundled-dev:&lt;/strong&gt; allow named imports from Node built-ins (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23858&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23858/hovercard&quot;&gt;#23858&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/4260c756944a430e897f689efcfa4f8648953488&quot;&gt;4260c75&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;bundled-dev:&lt;/strong&gt; reload when hmr cannot run an entry again (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23849&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23849/hovercard&quot;&gt;#23849&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/a236886026c3a5de0680ea616de7de830d7a90e7&quot;&gt;a236886&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;deps:&lt;/strong&gt; update &lt;code&gt;@rollup/plugin-alias&lt;/code&gt; to v6.0.1 (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23862&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23862/hovercard&quot;&gt;#23862&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/67c965b1df64249bceb747037e87d22f75b3e471&quot;&gt;67c965b&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;deps:&lt;/strong&gt; update all non-major dependencies (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23896&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23896/hovercard&quot;&gt;#23896&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/46b91c5bf9c2901b8511c893bc3fc38b8bba6e4f&quot;&gt;46b91c5&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;deps:&lt;/strong&gt; update all non-major dependencies (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23966&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23966/hovercard&quot;&gt;#23966&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/b3cb0575aff63004a71301a1ec798aeea2aa05d7&quot;&gt;b3cb057&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;deps:&lt;/strong&gt; update rolldown-related dependencies (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23868&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23868/hovercard&quot;&gt;#23868&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/a63eb8722e7d47d1efb710b6410c8d5e5a04a18f&quot;&gt;a63eb87&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;deps:&lt;/strong&gt; update rolldown-related dependencies (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23967&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23967/hovercard&quot;&gt;#23967&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/0105733e610dd5b770bb5397e8d9fbc54a9f6312&quot;&gt;0105733&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;dev:&lt;/strong&gt; escape ANSI escape sequence for &lt;code&gt;server.forwardConsole&lt;/code&gt; (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23933&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23933/hovercard&quot;&gt;#23933&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/4f340fdb1b619089bbf8ae5dc56c2c0866224306&quot;&gt;4f340fd&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;html:&lt;/strong&gt; remove adjacent module tags on the first line (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23823&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23823/hovercard&quot;&gt;#23823&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/eab1dc2752fcccf7f06427afc9915794e256e3bc&quot;&gt;eab1dc2&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;ignore pnpm&#39;s .modules.yaml as a Vite Task input (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23634&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23634/hovercard&quot;&gt;#23634&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/95c2daf1352b3509ec93e6e08a0eaabe23a61b28&quot;&gt;95c2daf&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;optimizer:&lt;/strong&gt; detect cache dir precisely (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23912&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23912/hovercard&quot;&gt;#23912&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/cc9bc2131d471bb4d60364614b326ada3ca7d10d&quot;&gt;cc9bc21&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;optimizer:&lt;/strong&gt; resolve subpath imports (#) with Vite&#39;s resolver (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23959&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23959/hovercard&quot;&gt;#23959&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/0fdd81e9460dd44806b2b6290603ee2c8366a54e&quot;&gt;0fdd81e&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;respect &lt;code&gt;build.sourcemap&lt;/code&gt; from environment (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23879&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23879/hovercard&quot;&gt;#23879&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/82e7aa0374a15e1c67594557ab5893c91578f897&quot;&gt;82e7aa0&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;server:&lt;/strong&gt; escape HTML attributes (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23995&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23995/hovercard&quot;&gt;#23995&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/a27039101e3726498063c9662da9c0c097016bd1&quot;&gt;a270391&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;server:&lt;/strong&gt; preserve &lt;code&gt;$&lt;/code&gt; patterns in static alias replacements (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23703&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23703/hovercard&quot;&gt;#23703&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/1b6ed05397c0670e6114e3e1380188f0313ae590&quot;&gt;1b6ed05&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;ssr:&lt;/strong&gt; convert external require against built-in modules to import for &lt;code&gt;ssr.target=webworker&lt;/code&gt; (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23759&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23759/hovercard&quot;&gt;#23759&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/a711f1c6328ca7f59857ed99e32853cf49b19a15&quot;&gt;a711f1c&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;use top-level &lt;code&gt;input&lt;/code&gt; for SSR build when &lt;code&gt;build.ssr: true&lt;/code&gt; (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23898&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23898/hovercard&quot;&gt;#23898&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/90bc034a97e7eccd0f3cbc69904fffa625a4c34d&quot;&gt;90bc034&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;wasm:&lt;/strong&gt; reject &lt;code&gt;.wasm&lt;/code&gt; outside &lt;code&gt;server.fs&lt;/code&gt; (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23914&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23914/hovercard&quot;&gt;#23914&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/64e24670e49900c33a3d3e3c701a5ec4d76573f2&quot;&gt;64e2467&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;watch files that have a query or hash referenced with &lt;code&gt;new URL(..., import.meta.url)&lt;/code&gt; (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23780&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23780/hovercard&quot;&gt;#23780&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/e954a9cda0b5254be495a937333a0be1b8503d8f&quot;&gt;e954a9c&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;worker:&lt;/strong&gt; keep chunks conflicted with unused workers that are still used by a live worker (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23956&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23956/hovercard&quot;&gt;#23956&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/7139ef35cf6c9c0979385a467e8499fc19dfd099&quot;&gt;7139ef3&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Performance Improvements&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;build:&lt;/strong&gt; remove preload link listeners on settle (fix &lt;a href=&quot;https://github.com/vitejs/vite/issues/23920&quot; data-hovercard-type=&quot;issue&quot; data-hovercard-url=&quot;/vitejs/vite/issues/23920/hovercard&quot;&gt;#23920&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23922&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23922/hovercard&quot;&gt;#23922&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/8109efd30319704224db3b7e3b7090348999effb&quot;&gt;8109efd&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;css:&lt;/strong&gt; index rendered modules once per output for &lt;code&gt;cssScopeTo&lt;/code&gt; (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23889&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23889/hovercard&quot;&gt;#23889&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/1b905e562aed9b47c3ab5959149bb1566eb7a9a5&quot;&gt;1b905e5&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Miscellaneous Chores&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;align charset case (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23863&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23863/hovercard&quot;&gt;#23863&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/a976df38815d00102bb1d9fa32e0fec7c05d210a&quot;&gt;a976df3&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Build System&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;generate sourcemaps in import-meta-current-dirname plugin (&lt;a href=&quot;https://github.com/vitejs/vite/issues/23904&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vitejs/vite/pull/23904/hovercard&quot;&gt;#23904&lt;/a&gt;) (&lt;a href=&quot;https://github.com/vitejs/vite/commit/20d355a00b036499f4b9fd5aa99ff754ca3d4d06&quot;&gt;20d355a&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;</content>
