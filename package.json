{
  "name": "dea",
  "private": true,
  "type": "module",
  "description": "Decode anything on the web: an evidence-first CLI and MCP server for AI agents and humans.",
  "author": "Jehad Uddin",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dea": "tsx packages/cli/src/index.ts",
    "mcp": "tsx packages/mcp/src/stdio.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --mode e2e",
    "build": "pnpm --filter dea-cli --filter dea-mcp run build",
    "pack:smoke": "pnpm build && node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jehad123-lab/dea"
  },
  "keywords": [
    "mcp",
    "playwright",
    "design",
    "webgl",
    "three.js",
    "gsap",
    "reverse-engineering",
    "cli"
  ]
}
